{
  "name": "gateway-chat",
  "version": "1.1.0",
  "description": "Tulai: the bridge between you and your company Claude",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --dir",
    "prebuild": "node scripts/repo-check.js && node scripts/fetch-models.js && node build/compile-helpers.js && node build/bundle-engines.js && node scripts/pack-versions.js",
    "test": "node scripts/test-all.js",
    "test:core": "node test/run.js",
    "test:activation": "node scripts/test-activation.js",
    "check": "node -e \"const fs=require('fs');let bad=0;for(const f of fs.readdirSync('.').filter(x=>x.endsWith('.js'))){try{new (require('vm').Script)(fs.readFileSync(f,'utf8').replace(/^#!.*/,''),{filename:f})}catch(e){console.log('SYNTAX',f,e.message);bad++}}const pk=require('./package.json'),inc=new Set(pk.build.files);for(const x of fs.readdirSync('.').filter(n=>n.endsWith('.js'))){for(const m of fs.readFileSync(x,'utf8').matchAll(/require\\\\('\\\\.\\\\/([\\\\w-]+)'\\\\)/g)){if(!inc.has(m[1]+'.js')){console.log('NOT PACKAGED',m[1],'needed by',x);bad++}}}console.log(bad?bad+' problem(s)':'syntax and packaging ok');process.exit(bad?1:0)\"",
    "verify": "npm run check && npm test",
    "smoke": "node scripts/smoke.js",
    "setup": "node scripts/setup.js",
    "models": "node scripts/fetch-models.js",
    "models:check": "node scripts/fetch-models.js --check",
    "repo:check": "node scripts/repo-check.js",
    "test:corrections": "node test/web-corrections.js && node test/web-preview.js && node test/reminder-wording.js && node test/learning-review.js && node test/automatic-learning.js && node test/rich-formatting.js && node test/composer-keyboard.js && node test/render-request.js",
    "training:setup": "node scripts/setup-training.js",
    "training:prepare": "python3 scripts/finetune.py prepare",
    "training:pilot": "node scripts/training-run.js run",
    "training:reviewed": "node scripts/training-run.js run --reviewed",
    "training:evaluate": "node scripts/training-run.js evaluate",
    "training": "node scripts/training-run.js run --evaluate",
    "training:skills": "node scripts/training-run.js run --skills --evaluate",
    "setup:check": "node scripts/check-setup.js",
    "predmg": "node scripts/repo-check.js && node scripts/fetch-models.js && node build/compile-helpers.js && node build/bundle-engines.js && node scripts/pack-versions.js",
    "dmg": "electron-builder --mac dmg",
    "dmg:full": "TULAI_SLIM=0 electron-builder --mac dmg",
    "predmg:full": "node scripts/repo-check.js && node scripts/fetch-models.js && node build/compile-helpers.js && node build/bundle-engines.js && node scripts/pack-versions.js",
    "test:acceptance": "node scripts/pack-acceptance.js --mode model",
    "test:acceptance:app": "node scripts/pack-acceptance.js --mode app"
  },
  "build": {
    "appId": "local.gatewaychat",
    "productName": "Tulai",
    "files": [
      "main.js",
      "scenarios.js",
      "human-rules.js",
      "missed.js",
      "screen-solve.js",
      "agent-mode.js",
      "helper-bot.js",
      "local-fit.js",
      "status-report.js",
      "git-prefs.js",
      "report-charts.js",
      "helper-window.js",
      "scenario-runner.js",
      "approvals.js",
      "git-commit.js",
      "bot-features.js",
      "preload.js",
      "server.js",
      "snapshots.js",
      "ws.js",
      "bridge.js",
      "converse.js",
      "bot-team.js",
      "bot-room.js",
      "bot-memory.js",
      "vector-memory.js",
      "memory-embeddings.js",
      "voice.js",
      "bot-window.js",
      "computer.js",
      "local.js",
      "nlu.js",
      "harness.js",
      "sysmem.js",
      "meeting.js",
      "mood.js",
      "profile.js",
      "engine.js",
      "data/**/*",
      "missions.js",
      "mcp.js",
      "browser.js",
      "icongen.js",
      "store.js",
      "diagnostics.js",
      "shots.js",
      "agent.js",
      "public/**/*",
      "skills/**/*",
      "main-bot.js",
      "main-desktop.js",
      "prefs-store.js",
      "webcal.js",
      "reminders.js",
      "work.js",
      "work-rules.js",
      "dev-rules.js",
      "lead-rules.js",
      "suggest.js",
      "habits.js",
      "bot-partners.js",
      "bot-work.js",
      "report-html.js",
      "chat-memory.js",
      "bot-schedule.js",
      "bot-browser.js",
      "failure-memory.js",
      "failure-research.js",
      "bot-identity.js",
      "bot-learning-status.js",
      "export.js",
      "view-rules.js",
      "viewer.js",
      "folder-drop.js",
      "folder-rules.js",
      "engines.js",
      "engine-rules.js",
      "hf-models.js",
      "term.js",
      "browser-mcp.js",
      "pack-solvers.js",
      "acceptance-packs.js",
      "self-test.js",
      "live-answer.js",
      "call-window.js",
      "call-detect.js",
      "screen-code.js",
      "mock-call.js",
      "teams-send.js",
      "label-report.js",
      "web-account-rules.js",
      "bot-web.js",
      "bot-analyst.js",
      "scripts/profile-csv.py",
      "scripts/pty-host.py",
      "analyst-report.js",
      "commit-charts.js",
      "document-work.js",
      "scripts/read-document.py",
      "render-request.js",
      "code-ingest.js",
      "learning-review.js",
      "web-preview.js",
      "handoff-policy.js",
      "finetune-status.js",
      "bot-training.js",
      "scripts/finetune.py",
      "scripts/coding-data.py",
      "scripts/coding-practice.py",
      "scripts/springboot-data.py",
      "scripts/springboot-practice.py",
      "scripts/springboot-verify.py",
      "scripts/code-exec.js",
      "scripts/evaluate-finetune.py",
      "training-config/pilot-examples.json",
      "training-config/rehearsal.json",
      "training-config/skills-recipe.json",
      "task-dataset.js",
      "active-model.js",
      "scripts/prepare-activation.py",
      "scripts/activation-gate.py",
      "scripts/skill-data.py",
      "training-config/nlu-gate-cases.json",
      "training-config/nlu-examples.json",
      "training-config/chat-rehearsal.json",
      "scripts/nlu-gate.js",
      "installer.js",
      "models.json",
      "custom-training.js",
      "scripts/memory-skills.py",
      "training-pack.js",
      "free-data.js",
      "scripts/free-data.py",
      "training-config/free-data.json",
      "calendar-day-rules.js",
      "skill-packs.js",
      "scripts/pack-skills.py",
      "training-config/skill-packs.json",
      "training-config/jira-knowledge.json",
      "training-config/acceptance-prompts.json",
      "training-config/agent-episodes.json",
      "training-config/pack-versions.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Tulai listens for \"Hey Tulai\" and your voice commands. Audio is processed on this Mac.",
        "NSSpeechRecognitionUsageDescription": "Tulai turns your voice into text on this Mac so you can talk to it.",
        "NSAppleEventsUsageDescription": "Tulai can control other apps on your Mac when you ask it to.",
        "NSScreenCaptureUsageDescription": "Tulai can look at your screen when you ask it to."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "extraMetadata": {
      "main": "main.js"
    },
    "extraResources": [
      {
        "from": "build/bin",
        "to": "bin"
      },
      {
        "from": "build/models",
        "to": "models"
      }
    ],
    "asarUnpack": [
      "node_modules/selenium-webdriver/bin/**/*"
    ],
    "afterPack": "build/protect.js",
    "dmg": {
      "title": "Install Tulai",
      "background": "build/dmg-bg.tiff",
      "icon": "build/icon.icns",
      "iconSize": 110,
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 165,
          "y": 190,
          "type": "file"
        },
        {
          "x": 495,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "writeUpdateInfo": false
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "bytenode": "^1.5.7",
    "selenium-webdriver": "^4.50.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
